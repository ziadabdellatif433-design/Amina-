```html
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amina - Heart Animation</title>
    <!-- Tailwind CSS for UI controls & styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts for typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }
        body {
            background-color: #05020a;
            color: #ffffff;
            font-family: 'Tajawal', sans-serif;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
        }
        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }
        .name-font {
            font-family: 'Great Vibes', cursive;
        }
        /* Custom Glowing & Pulsing Text */
        .neon-text {
            color: #fff;
            text-shadow: 
                0 0 7px #ff0055,
                0 0 10px #ff0055,
                0 0 21px #ff0055,
                0 0 42px #ff0077,
                0 0 82px #ff0077,
                0 0 92px #ff0077,
                0 0 102px #ff0077,
                0 0 151px #ff0077;
            animation: pulseText 1.2s infinite ease-in-out alternate;
        }

        @keyframes pulseText {
            0% {
                transform: scale(1) translate(-50%, -50%);
                text-shadow: 
                    0 0 5px #ff1493,
                    0 0 15px #ff1493,
                    0 0 30px #ff1493,
                    0 0 60px #ff0055;
            }
            100% {
                transform: scale(1.08) translate(-46%, -46%);
                text-shadow: 
                    0 0 10px #ff69b4,
                    0 0 25px #ff69b4,
                    0 0 45px #ff1493,
                    0 0 90px #ff0055,
                    0 0 120px #ff0055;
            }
        }

        /* Glassmorphism control panel */
        .glass-panel {
            background: rgba(15, 5, 25, 0.4);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 105, 180, 0.2);
            box-shadow: 0 8px 32px 0 rgba(255, 0, 100, 0.2);
        }

        /* Ambient glowing background circles */
        .glow-bg {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            z-index: 0;
            pointer-events: none;
        }
    </style>
</head>
<body class="relative flex items-center justify-center min-h-screen overflow-hidden">

    <!-- Ambient Glowing Background Spheres -->
    <div class="glow-bg w-96 h-96 bg-pink-600/30 top-1/4 left-1/4 animate-pulse"></div>
    <div class="glow-bg w-80 h-80 bg-purple-700/20 bottom-1/4 right-1/4 animate-pulse" style="animation-delay: 1s;"></div>

    <!-- Main Canvas for Particle Heart -->
    <canvas id="heartCanvas"></canvas>

    <!-- Overlay Center Name -->
    <div id="centerContainer" class="absolute z-10 pointer-events-none text-center transform top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
        <h1 id="displayName" class="name-font neon-text text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-bold tracking-wider">
            Amina
        </h1>
        <p id="subMessage" class="text-pink-200/80 text-sm sm:text-base mt-2 font-light tracking-widest opacity-90 transition-all duration-500">
            💖 Always & Forever 💖
        </p>
    </div>

    <!-- Interactive Floating Controls -->
    <div class="absolute bottom-6 z-20 flex flex-wrap justify-center gap-3 px-4 w-full max-w-md">
        <div class="glass-panel rounded-full p-2 flex items-center gap-2 w-full justify-between px-4">
            <!-- Theme / Color Preset Toggle -->
            <button id="btnColor" title="تغيير الألوان" class="text-pink-300 hover:text-white hover:bg-pink-500/20 p-2.5 rounded-full transition-all duration-300 flex items-center justify-center">
                <i class="fa-solid fa-palette text-lg"></i>
            </button>

            <!-- Burst Particles Effect -->
            <button id="btnBurst" title="إطلاق نيازك الحب" class="text-pink-300 hover:text-white hover:bg-pink-500/20 p-2.5 rounded-full transition-all duration-300 flex items-center justify-center">
                <i class="fa-solid fa-wand-magic-sparkles text-lg"></i>
            </button>

            <!-- Toggle Speed / Pulse -->
            <button id="btnSpeed" title="تسريع / تبطئ النبض" class="text-pink-300 hover:text-white hover:bg-pink-500/20 p-2.5 rounded-full transition-all duration-300 flex items-center justify-center">
                <i class="fa-solid fa-heart-pulse text-lg"></i>
            </button>

            <!-- Edit Name Button -->
            <button id="btnEdit" title="تعديل الاسم" class="text-pink-300 hover:text-white hover:bg-pink-500/20 p-2.5 rounded-full transition-all duration-300 flex items-center justify-center">
                <i class="fa-solid fa-pen-to-square text-lg"></i>
            </button>
        </div>
    </div>

    <!-- Modal for Editing Name -->
    <div id="editModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
        <div class="glass-panel p-6 rounded-2xl w-11/12 max-w-sm text-center transform scale-95 transition-transform duration-300" id="modalCard">
            <h3 class="text-xl font-bold text-pink-300 mb-4">تعديل النص الظاهر</h3>
            <input type="text" id="inputName" value="Amina" placeholder="أدخل الاسم..." class="w-full bg-black/50 border border-pink-500/40 rounded-xl px-4 py-2 text-white text-center text-lg focus:outline-none focus:border-pink-400 mb-3" />
            <input type="text" id="inputSubText" value="💖 Always & Forever 💖" placeholder="عبارة قصيرة..." class="w-full bg-black/50 border border-pink-500/40 rounded-xl px-4 py-2 text-white text-center text-sm focus:outline-none focus:border-pink-400 mb-5" />
            <div class="flex justify-center gap-3">
                <button id="btnSaveModal" class="bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 text-white px-6 py-2 rounded-xl text-sm font-semibold transition-all shadow-lg shadow-pink-500/30">
                    حفظ
                </button>
                <button id="btnCloseModal" class="bg-white/10 hover:bg-white/20 text-gray-300 px-4 py-2 rounded-xl text-sm font-semibold transition-all">
                    إلغاء
                </button>
            </div>
        </div>
    </div>

    <!-- Main Logic Animation Code -->
    <script>
        // Setup Canvas & Context
        const canvas = document.getElementById('heartCanvas');
        const ctx = canvas.getContext('2d');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        // Colors Presets
        const colorPalettes = [
            { main: '#ff1493', sub: '#ff69b4', glow: 'rgba(255, 20, 147, 0.8)' }, // Classic Neon Pink
            { main: '#ff3366', sub: '#ff99bb', glow: 'rgba(255, 51, 102, 0.8)' }, // Crimson Passion
            { main: '#9d4edd', sub: '#c77dff', glow: 'rgba(157, 78, 221, 0.8)' }, // Violet Dream
            { main: '#00f5d4', sub: '#7b2cbf', glow: 'rgba(0, 245, 212, 0.8)' },  // Cyber Cyan & Purple
            { main: '#ffb703', sub: '#fb8500', glow: 'rgba(255, 183, 3, 0.8)' }   // Warm Gold
        ];
        let currentPaletteIdx = 0;

        // Particle System Configuration
        let particles = [];
        let heartPoints = [];
        const numParticles = Math.min(window.innerWidth < 640 ? 1200 : 2200, 2500);
        let heartScale = 1;
        let pulseSpeed = 0.04;
        let pulseAngle = 0;

        // Mathematical Heart Curve Function
        function getHeartPoint(t) {
            // Parametric equations for heart shape
            const x = 16 * Math.pow(Math.sin(t), 3);
            const y = -(13 * Math.cos(t) - 5 * Math.cos(2*t) - 2 * Math.cos(3*t) - Math.cos(4*t));
            return { x, y };
        }

        // Initialize Heart Points Array
        function generateHeartPoints() {
            heartPoints = [];
            for (let i = 0; i < Math.PI * 2; i += 0.01) {
                heartPoints.push(getHeartPoint(i));
            }
        }

        // Particle Class definition
        class Particle {
            constructor() {
                this.reset();
            }

            reset() {
                // Pick a random target on the heart contour
                const pt = heartPoints[Math.floor(Math.random() * heartPoints.length)];
                
                // Scale factor adjusted based on screen dimensions
                const scaleFactor = Math.min(width, height) / 45;
                
                // Slight scatter effect inside/around heart
                const scatter = (Math.random() - 0.5) * 20;

                this.targetX = width / 2 + pt.x * scaleFactor + scatter;
                this.targetY = height / 2 + pt.y * scaleFactor + scatter;

                // Random starting point anywhere on canvas
                this.x = width / 2 + (Math.random() - 0.5) * width;
                this.y = height / 2 + (Math.random() - 0.5) * height;

                this.size = Math.random() * 2.5 + 0.8;
                this.speed = Math.random() * 0.03 + 0.01;
                
                // Alpha & lifetime
                this.alpha = Math.random() * 0.7 + 0.3;
                this.color = Math.random() > 0.3 ? colorPalettes[currentPaletteIdx].main : colorPalettes[currentPaletteIdx].sub;
                
                // Velocity offset for floating behavior
                this.vx = (Math.random() - 0.5) * 0.5;
                this.vy = (Math.random() - 0.5) * 0.5;
            }

            update(pulseFactor) {
                // Calculate position relative to pulsing center
                const scaleFactor = Math.min(width, height) / 45 * pulseFactor;
                const ptIndex = Math.floor(Math.random() * heartPoints.length);
                const pt = heartPoints[ptIndex];
                
                const targetX = width / 2 + pt.x * scaleFactor;
                const targetY = height / 2 + pt.y * scaleFactor;

                // Smooth ease towards target point
                this.x += (targetX - this.x) * this.speed + this.vx;
                this.y += (targetY - this.y) * this.speed + this.vy;

                // Pulsing size oscillation
                this.currentAlpha = this.alpha * (0.8 + Math.sin(pulseAngle) * 0.2);
            }

            draw() {
                ctx.save();
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.shadowBlur = 10;
                ctx.shadowColor = this.color;
                ctx.globalAlpha = this.currentAlpha;
                ctx.fill();
                ctx.restore();
            }
        }

        // Secondary Floating Stars / Dust Background Particles
        let bgParticles = [];
        class BgParticle {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.size = Math.random() * 1.5;
                this.speedY = -Math.random() * 0.4 - 0.1;
                this.alpha = Math.random() * 0.5 + 0.1;
            }
            update() {
                this.y += this.speedY;
                if (this.y < 0) {
                    this.y = height;
                    this.x = Math.random() * width;
                }
            }
            draw() {
                ctx.fillStyle = 'rgba(255, 255, 255, ' + this.alpha + ')';
                ctx.fillRect(this.x, this.y, this.size, this.size);
            }
        }

        // Init System
        function init() {
            generateHeartPoints();
            
            // Build main heart particles
            particles = [];
            for (let i = 0; i < numParticles; i++) {
                particles.push(new Particle());
            }

            // Build ambient background particles
            bgParticles = [];
            for (let i = 0; i < 80; i++) {
                bgParticles.push(new BgParticle());
            }
        }

        // Animation Loop
        function animate() {
            // Trail effect background clear
            ctx.fillStyle = 'rgba(5, 2, 10, 0.25)';
            ctx.fillRect(0, 0, width, height);

            // Update pulse factor
            pulseAngle += pulseSpeed;
            // Beat dynamics (realistic heartbeat double beat pulse)
            const beat = Math.sin(pulseAngle);
            const pulseFactor = 1 + (beat > 0 ? Math.pow(beat, 2) * 0.12 : 0);

            // Draw ambient particles
            bgParticles.forEach(p => {
                p.update();
                p.draw();
            });

            // Update & Draw Heart Particles
            particles.forEach(p => {
                p.update(pulseFactor);
                p.draw();
            });

            requestAnimationFrame(animate);
        }

        // Window Resize Handler
        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            init();
        });

        // Touch & Click Interactive Burst Effect
        function createBurst(clickX, clickY) {
            for (let i = 0; i < 60; i++) {
                const p = new Particle();
                p.x = clickX;
                p.y = clickY;
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 6 + 2;
                p.vx = Math.cos(angle) * speed;
                p.vy = Math.sin(angle) * speed;
                p.speed = 0.08;
                particles.push(p);
            }
            // Trim excess particles after burst
            setTimeout(() => {
                if (particles.length > numParticles) {
                    particles.splice(numParticles);
                }
            }, 2000);
        }

        canvas.addEventListener('click', (e) => {
            createBurst(e.clientX, e.clientY);
        });

        // Interactivity Buttons
        document.getElementById('btnBurst').addEventListener('click', () => {
            createBurst(width / 2, height / 2);
        });

        document.getElementById('btnColor').addEventListener('click', () => {
            currentPaletteIdx = (currentPaletteIdx + 1) % colorPalettes.length;
            const newPal = colorPalettes[currentPaletteIdx];
            
            // Recolor heart particles
            particles.forEach(p => {
                p.color = Math.random() > 0.3 ? newPal.main : newPal.sub;
            });
        });

        let fastSpeed = false;
        document.getElementById('btnSpeed').addEventListener('click', () => {
            fastSpeed = !fastSpeed;
            pulseSpeed = fastSpeed ? 0.08 : 0.04;
        });

        // Modal Edit Name logic
        const modal = document.getElementById('editModal');
        const modalCard = document.getElementById('modalCard');
        const displayName = document.getElementById('displayName');
        const subMessage = document.getElementById('subMessage');
        const inputName = document.getElementById('inputName');
        const inputSubText = document.getElementById('inputSubText');

        document.getElementById('btnEdit').addEventListener('click', () => {
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalCard.classList.remove('scale-95');
                modalCard.classList.add('scale-100');
            }, 10);
        });

        function closeModal() {
            modal.classList.add('opacity-0');
            modalCard.classList.remove('scale-100');
            modalCard.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        document.getElementById('btnCloseModal').addEventListener('click', closeModal);

        document.getElementById('btnSaveModal').addEventListener('click', () => {
            if (inputName.value.trim() !== '') {
                displayName.textContent = inputName.value.trim();
            }
            subMessage.textContent = inputSubText.value.trim();
            closeModal();
            createBurst(width / 2, height / 2);
        });

        // Start Animation on load
        window.onload = function() {
            init();
            animate();
        };
    </script>
</body>
</html>
```
